# ---------------------------------------------------------------------------
# Mandatory env variables
# ---------------------------------------------------------------------------
# Django signing / sessions. Must be a long random string when DEBUG=false.
SECRET_KEY=change-me-generate-a-long-random-string

# API key for LLM planning/analysis. Set the one that matches LLM_PROVIDER
# (default provider is openrouter). Leave blank only if you never use Plan.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=   # use instead when LLM_PROVIDER=openai

# ---------------------------------------------------------------------------
# Optional variables (default values are hardcoded in docker-compose.yml)
# ---------------------------------------------------------------------------

# Django debug mode (true = verbose errors; false requires a strong SECRET_KEY).
DEBUG=true

# Comma-separated Host headers Django accepts (include web,edge under Compose).
ALLOWED_HOSTS=localhost,127.0.0.1,web,edge

# Host port published by the HTTPS edge (Caddy) container.
WEB_PORT=8000

# Hostname used in the edge TLS cert / Caddy site address.
PUBLIC_HOST=localhost

# Canonical public origin (drives secure cookies when https://).
PUBLIC_URL=https://localhost:8000

# Origins allowed to POST with CSRF (must match the URL you open in the browser).
CSRF_TRUSTED_ORIGINS=https://localhost:8000,https://127.0.0.1:8000

# Runtime data root: SQLite, staticfiles, project workspaces (Compose uses /data).
PEON_DATA_DIR=data

# Which LLM backend litellm talks to (openrouter | openai | …).
LLM_PROVIDER=openrouter

# litellm model id (OpenRouter ids are usually openrouter/<vendor>/<model>).
LITELLM_MODEL=openrouter/openai/gpt-4o-mini

# Sampling temperature for chat/planning calls.
LLM_TEMPERATURE=0

# Filesystem Agent Skills catalog (relative to repo root unless absolute).
SKILLS_DIR=skills

# Tool package catalog for sandbox install / binary resolution.
TOOLS_CATALOG_DIR=tools/catalog

# true = one Docker sandbox per Project; false = one shared Docker sandbox.
# Skill scripts never run on the host — docker is required either way.
SANDBOX_ENABLED=true

# Image tag for sandboxes (build: compose --profile build build sandbox).
SANDBOX_IMAGE=peon-sandbox:local

# Docker container name prefix (per-project: <prefix>-<uuid>; shared: <prefix>-shared).
PROJECT_SANDBOX_PREFIX=peon-project

# Redis broker URL for Dramatiq (Compose service: redis://redis:6379/0).
REDIS_URL=redis://redis:6379/0

# Use Dramatiq actors (false = poll fallback via manage.py run_worker).
DRAMATIQ_ENABLED=true

# Soft wall-clock limit per actor run in ms (default 6h for long OSINT/pentest jobs).
DRAMATIQ_TIME_LIMIT_MS=21600000

# Dramatiq worker thread pool (Compose entrypoint). Peon Settings can override;
# changing threads requires restarting the worker service.
DRAMATIQ_THREADS=4

# How many projects may have RUNNING work at once (live via Settings UI).
MAX_PARALLEL_PROJECTS=3
# RUNNING jobs (root + subagents) allowed per project (live via Settings UI).
MAX_AGENTS_PER_PROJECT=2

# ---------------------------------------------------------------------------
# Agent runtime (LangGraph per Job — orchestrator.agent)
# ---------------------------------------------------------------------------
# Replan/recover passes after failure streaks within one Job.
AGENT_MAX_FAILURE_REPLANS=2
# Hard cap on act↔tool iterations per Job.
AGENT_MAX_ITERATIONS=40
# Max concurrent child Jobs spawned via spawn_subagent.
AGENT_MAX_SUBAGENTS=4
# Max Job parent→child depth (2 = root + one subagent level).
AGENT_MAX_SUBAGENT_DEPTH=2
# Emergency kill switch (default on). false → agent refuses; no legacy script loop.
AGENT_RUNTIME_ENABLED=true
